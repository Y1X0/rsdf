# Copy this file to .env and fill in real values for local development.
# Never commit a real .env file — it is already in .gitignore.

# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/content_factory

# --- Auth (v1.1) ---
# REQUIRED for real use — every authenticated route fails closed (500) if
# JWT_SECRET_KEY is empty. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse the value from tests/conftest.py.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
# Pre-shared service credentials issued a token via POST /auth/token.
# Phase 1 has no user database — see docs/PHASE1.md's "Authentication" section.
AUTH_CLIENT_ID=phase1-operator
AUTH_CLIENT_SECRET=
# Phase 2 M1 (PHASE1_AUDIT_v2.md N1): fixed-window rate limit on POST /auth/token.
AUTH_TOKEN_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_TOKEN_RATE_LIMIT_WINDOW_SECONDS=60

# --- Notifications (Phase 2 M1 — budget alerts etc.) ---
# "log" (default) structured-logs every notification, no external dependency.
# "slack" needs SLACK_WEBHOOK_URL and the "notifications" extra (httpx);
# "email" needs the SMTP_* settings (uses stdlib smtplib, no extra needed).
# Falls back to "log" automatically if the chosen provider's config is missing.
NOTIFICATION_PROVIDER=log
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_ADDR=
SMTP_TO_ADDR=

# --- Quality gating (Phase 2 M2) ---
# Opt-in, disabled by default (0 / 100 can never actually be breached by a
# real 0..100 score) — set these to have low-originality or high-policy-risk
# videos auto-reject straight to the review audit trail instead of landing
# in the normal pending_review queue.
QUALITY_ORIGINALITY_AUTO_REJECT_FLOOR=0
QUALITY_POLICY_RISK_AUTO_REJECT_CEILING=100

# --- LLM provider (Research Agent, Script Agent) ---
# If ANTHROPIC_API_KEY is unset, LLM_PROVIDER falls back to "fake" automatically
# so the app and test suite run without real credentials.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_VERSION=2026-02-01

# --- Text-to-speech ---
# "silent" (default) produces a placeholder audio manifest with no external
# call — useful for dev/CI without an ElevenLabs key. Set to "elevenlabs" to
# use a real key.
TTS_PROVIDER=silent
ELEVENLABS_API_KEY=

# --- Video rendering ---
# "null" (default) writes a render manifest instead of a real video file, so
# the pipeline works without ffmpeg/Pillow installed. Set to "template_pillow"
# once the "rendering" extra (pip install '.[rendering]') is installed.
RENDERER_BACKEND=null

# --- Storage ---
# Local filesystem directory for rendered assets (Phase 1). Swap for S3/R2 in
# a later phase without changing calling code (see services/production_service.py).
MEDIA_STORAGE_DIR=./var/media

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
